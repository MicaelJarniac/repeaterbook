{
  "$defs": {
    "DStarParams": {
      "additionalProperties": false,
      "description": "RepeaterBook carries no D-STAR parameters; intentionally empty.",
      "properties": {
        "mode": {
          "const": "DSTAR",
          "default": "DSTAR",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "DStarParams",
      "type": "object"
    },
    "DmrParams": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "DMR",
          "default": "DMR",
          "title": "Mode",
          "type": "string"
        },
        "dmr_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dmr Id"
        },
        "color_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color Code"
        }
      },
      "title": "DmrParams",
      "type": "object"
    },
    "FmParams": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "FM",
          "default": "FM",
          "title": "Mode",
          "type": "string"
        },
        "bandwidth_khz": {
          "anyOf": [
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bandwidth Khz"
        }
      },
      "title": "FmParams",
      "type": "object"
    },
    "FusionParams": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "FUSION",
          "default": "FUSION",
          "title": "Mode",
          "type": "string"
        },
        "digital_id_uplink": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digital Id Uplink"
        },
        "digital_id_downlink": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Digital Id Downlink"
        },
        "dsc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dsc"
        }
      },
      "title": "FusionParams",
      "type": "object"
    },
    "M17Params": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "M17",
          "default": "M17",
          "title": "Mode",
          "type": "string"
        },
        "can": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Can"
        }
      },
      "title": "M17Params",
      "type": "object"
    },
    "NxdnParams": {
      "additionalProperties": false,
      "description": "RepeaterBook carries no NXDN parameters; intentionally empty.",
      "properties": {
        "mode": {
          "const": "NXDN",
          "default": "NXDN",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "NxdnParams",
      "type": "object"
    },
    "P25Params": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "P25",
          "default": "P25",
          "title": "Mode",
          "type": "string"
        },
        "nac": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nac"
        }
      },
      "title": "P25Params",
      "type": "object"
    },
    "RepeaterMode": {
      "description": "A single radio operating mode for one programmable channel.",
      "enum": [
        "FM",
        "DMR",
        "DSTAR",
        "FUSION",
        "P25",
        "NXDN",
        "TETRA",
        "M17"
      ],
      "title": "RepeaterMode",
      "type": "string"
    },
    "TetraParams": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "const": "TETRA",
          "default": "TETRA",
          "title": "Mode",
          "type": "string"
        },
        "mcc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mcc"
        },
        "mnc": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mnc"
        }
      },
      "title": "TetraParams",
      "type": "object"
    }
  },
  "description": "One programmable radio channel; `params` is discriminated on its mode.",
  "properties": {
    "name": {
      "title": "Name",
      "type": "string"
    },
    "callsign": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Callsign"
    },
    "rx_frequency_mhz": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Rx Frequency Mhz",
      "type": "string"
    },
    "tx_frequency_mhz": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Tx Frequency Mhz",
      "type": "string"
    },
    "ctcss_tx_hz": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ctcss Tx Hz"
    },
    "ctcss_rx_hz": {
      "anyOf": [
        {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Ctcss Rx Hz"
    },
    "dcs_code": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Dcs Code"
    },
    "latitude": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Latitude",
      "type": "string"
    },
    "longitude": {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "title": "Longitude",
      "type": "string"
    },
    "distance_km": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "title": "Distance Km"
    },
    "operational_status": {
      "enum": [
        "OFF_AIR",
        "ON_AIR",
        "UNKNOWN"
      ],
      "title": "Operational Status",
      "type": "string"
    },
    "use": {
      "enum": [
        "OPEN",
        "PRIVATE",
        "CLOSED"
      ],
      "title": "Use",
      "type": "string"
    },
    "band": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Band"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Notes"
    },
    "last_update": {
      "format": "date",
      "title": "Last Update",
      "type": "string"
    },
    "source": {
      "default": "repeaterbook",
      "title": "Source",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "params": {
      "discriminator": {
        "mapping": {
          "DMR": "#/$defs/DmrParams",
          "DSTAR": "#/$defs/DStarParams",
          "FM": "#/$defs/FmParams",
          "FUSION": "#/$defs/FusionParams",
          "M17": "#/$defs/M17Params",
          "NXDN": "#/$defs/NxdnParams",
          "P25": "#/$defs/P25Params",
          "TETRA": "#/$defs/TetraParams"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/FmParams"
        },
        {
          "$ref": "#/$defs/DmrParams"
        },
        {
          "$ref": "#/$defs/DStarParams"
        },
        {
          "$ref": "#/$defs/FusionParams"
        },
        {
          "$ref": "#/$defs/P25Params"
        },
        {
          "$ref": "#/$defs/NxdnParams"
        },
        {
          "$ref": "#/$defs/TetraParams"
        },
        {
          "$ref": "#/$defs/M17Params"
        }
      ],
      "title": "Params"
    },
    "mode": {
      "$ref": "#/$defs/RepeaterMode",
      "description": "The channel's mode, derived from `params` so the two cannot disagree.",
      "readOnly": true
    }
  },
  "required": [
    "name",
    "callsign",
    "rx_frequency_mhz",
    "tx_frequency_mhz",
    "ctcss_tx_hz",
    "ctcss_rx_hz",
    "dcs_code",
    "latitude",
    "longitude",
    "distance_km",
    "operational_status",
    "use",
    "band",
    "notes",
    "last_update",
    "source_id",
    "params",
    "mode"
  ],
  "title": "RepeaterSpec",
  "type": "object"
}
